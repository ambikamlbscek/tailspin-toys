---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const selectedCategoryIds = Astro.url.searchParams.getAll('category').map(Number).filter((value) => Number.isInteger(value) && value > 0);
const selectedPublisherId = Astro.url.searchParams.get('publisher');

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase(), {
  categoryIds: selectedCategoryIds.length > 0 ? selectedCategoryIds : undefined,
  publisherId: selectedPublisherId ? Number(selectedPublisherId) : undefined,
});
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-900/60 p-5 shadow-lg" data-testid="game-filters">
      <form method="get" class="flex flex-col gap-4 md:flex-row md:items-end" aria-label="Filter games">
        <div class="flex-1">
          <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Category</label>
          <select
            id="category-filter"
            name="category"
            multiple
            class="w-full min-h-32 rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="category-filter"
            aria-label="Filter games by category"
          >
            {categories.map((category) => (
              <option value={String(category.id)} selected={selectedCategoryIds.includes(category.id)}>
                {category.name}
              </option>
            ))}
          </select>
        </div>

        <div class="flex-1">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="publisher-filter"
            aria-label="Filter games by publisher"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={String(publisher.id)} selected={selectedPublisherId === String(publisher.id)}>
                {publisher.name}
              </option>
            ))}
          </select>
        </div>

        <div class="flex gap-3">
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="apply-filters"
          >
            Apply filters
          </button>
          <a
            href="/"
            class="inline-flex items-center justify-center rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="reset-filters"
          >
            Clear
          </a>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden rounded-xl border border-slate-700 bg-slate-800/60 p-6 text-slate-300" data-testid="no-matches">
            No games match the selected filters.
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filtersForm = document.querySelector('[data-testid="game-filters"] form') as HTMLFormElement | null;
  const categoryFilter = document.querySelector('[data-testid="category-filter"]') as HTMLSelectElement | null;
  const publisherFilter = document.querySelector('[data-testid="publisher-filter"]') as HTMLSelectElement | null;
  const gamesGrid = document.querySelector('[data-testid="games-grid"]') as HTMLElement | null;
  const noMatches = document.querySelector('[data-testid="no-matches"]') as HTMLElement | null;

  const applyFilters = () => {
    if (!categoryFilter || !publisherFilter || !gamesGrid) {
      return;
    }

    const selectedCategoryIds = Array.from(categoryFilter.selectedOptions).map((option) => Number(option.value)).filter((value) => Number.isInteger(value) && value > 0);
    const publisherId = publisherFilter.value ? Number(publisherFilter.value) : null;
    const params = new URLSearchParams(window.location.search);

    params.delete('category');
    selectedCategoryIds.forEach((categoryId) => {
      params.append('category', String(categoryId));
    });

    if (publisherId === null) {
      params.delete('publisher');
    } else {
      params.set('publisher', String(publisherId));
    }

    const nextUrl = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;
    window.history.replaceState({}, '', nextUrl);

    const cards = Array.from(gamesGrid.querySelectorAll('[data-game-id]')) as HTMLElement[];
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardCategoryId = Number(card.getAttribute('data-game-category-id'));
      const cardPublisherId = Number(card.getAttribute('data-game-publisher-id'));
      const matchesCategory = selectedCategoryIds.length === 0 || selectedCategoryIds.includes(cardCategoryId);
      const matchesPublisher = publisherId === null || cardPublisherId === publisherId;
      const isVisible = matchesCategory && matchesPublisher;

      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount += 1;
      }
    });

    gamesGrid.hidden = visibleCount === 0;
    if (noMatches) {
      noMatches.hidden = visibleCount !== 0;
    }
  };

  if (filtersForm && categoryFilter && publisherFilter) {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = params.getAll('category');
    const selectedPublisher = params.get('publisher');

    if (selectedCategories.length > 0) {
      categoryFilter.querySelectorAll('option').forEach((option) => {
        option.selected = selectedCategories.includes(option.value);
      });
    }

    if (selectedPublisher) {
      publisherFilter.value = selectedPublisher;
    }

    const submitFilter = (event: Event) => {
      event.preventDefault();
      applyFilters();
    };

    filtersForm.addEventListener('submit', submitFilter);
    categoryFilter.addEventListener('change', submitFilter);
    publisherFilter.addEventListener('change', submitFilter);
    applyFilters();
  }
</script>
